# Server settings for kalshi_live. setup.sh copies this to secrets/kalshi.env (chmod 600).
# secrets/ is git-ignored: never commit or paste this file or the key file anywhere.

# demo = Kalshi's demo exchange with mock money (keys from demo.kalshi.co)
# live = your real Kalshi account (keys from kalshi.com)
KALSHI_ENV=demo

# The API key ID shown next to the key on Kalshi (demo and live keys are different).
KALSHI_KEY_ID=paste-the-key-id-here

# The private key file Kalshi gave you when you created the key.
KALSHI_KEY_FILE=__APP_DIR__/secrets/kalshi.key

# Extra flags for the service. --dry-run logs the orders it would send and sends none.
# Limits (defaults shown): --max-order-pct 25 --daily-loss-pct 30 --stop-below 100 --max-orders-per-day 60 --cushion 0.01
# The first two are a % of the account, so they follow your balance. --max-order 100 / --daily-loss 150 add fixed
# dollar caps on top (the tighter one applies); leave them out to let the limits grow with the account.
# --hold 4 (default): a trigger must stay on for 4 seconds before an order. --hold 0 orders on the first look.
KALSHI_RUN_FLAGS=--dry-run

# Real-money orders need yes here AND a passed `deploy/kb smoke live` with the same key.
KALSHI_REAL_MONEY=no
